{
  "include": [
    "src",
    "@types/node",
    "stories"
  ],
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "types",
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES6",
    "paths": {
      "@mui/material/Paper": ["./src/custom/Paper"],
      "@mui/material/Box": ["./src/custom/Box"],
      "@mui/material/Button": ["./src/custom/Button"],
      "@mui/material/IconButton": ["./src/custom/IconButton"],
      "@mui/material/Tooltip": ["./src/custom/Tooltip"],
      "@mui/material/Stack": ["./src/custom/Stack"],
      "@mui/material/TableCell": ["./src/custom/TableCell"],
      "@mui/material/TableRow": ["./src/custom/TableRow"],
      "@mui/material/TableHead": ["./src/custom/TableHead"],
      "@mui/material/TableBody": ["./src/custom/TableBody"],
      "@mui/material/TableFooter": ["./src/custom/TableFooter"],
      "@mui/material/TableContainer": ["./src/custom/TableContainer"],
      "@mui/material/useMediaQuery": ["./src/custom/useMediaQuery"],
      "@mui/material/styles": ["./src/utils/color.utils"],
      "@mui/icons-material/*": ["./src/custom/icons/*"],
      "@mui/material/InputLabel": ["./src/custom/InputLabel"],
      "@mui/material/MenuItem": ["./src/custom/MenuItem"],
      "@mui/material/Select": ["./src/custom/Select"],
      "@mui/material/Typography": ["./src/custom/Typography"],
      "@mui/material/Pagination": ["./src/custom/Pagination"],
      "@mui/material/PaginationItem": ["./src/custom/PaginationItem"],
      "@mui/material/Autocomplete": ["./src/custom/Autocomplete"],
      "@mui/material/Checkbox": ["./src/custom/Checkbox"],
      "@mui/material/Chip": ["./src/custom/Chip"],
      "@mui/material/TextField": ["./src/custom/TextField"],
      "@mui/material/InputAdornment": ["./src/custom/InputAdornment"],
      "@mui/material/Skeleton": ["./src/custom/Skeleton"],
      "@mui/material/Table": ["./src/custom/Table"],
      "@mui/material/utils": ["./src/custom/utils"],
      "@mui/material/Collapse": ["./src/custom/Collapse"],
      "@mui/material/CircularProgress": ["./src/custom/CircularProgress"],
      "@mui/material/Menu": ["./src/custom/Menu"],
      "@mui/material/Popover": ["./src/custom/Popover"],
      "@mui/material/Grow": ["./src/custom/Grow"],
      "@mui/material/Divider": ["./src/custom/Divider"],
      "@mui/material/Badge": ["./src/custom/Badge"],
      "@mui/material/TableSortLabel": ["./src/custom/TableSortLabel"],
      "@mui/material/FormControlLabel": ["./src/custom/FormControlLabel"],
      "@mui/material/FormHelperText": ["./src/custom/FormHelperText"],
      "@mui/material/Slider": ["./src/custom/Slider"],
      "@mui/material/Radio": ["./src/custom/Radio"],
      "@mui/material/ListItemIcon": ["./src/custom/ListItemIcon"]
    }
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}