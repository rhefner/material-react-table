{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Remix Demo App Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "pnpm run dev",
      "env": {
        "PORT": "${input:port}"
      },
      "sourceMaps": true,
      "showAsyncStacks": true
    },
    {
      "name": "Remix Demo App Client",
      "type": "msedge",
      "request": "launch",
      "showAsyncStacks": true,
      "cleanUp": "wholeBrowser",
      "url": "http://localhost:${input:port}",
      "sourceMaps": true,
      "userDataDir": "${env:HOME}/.vscode-edge-debug",
    },
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Port number",
      "default": "5173"
    },
  ],
  "compounds": [
    {
      "name": "Debug Remix Demo (Client + Server)",
      "configurations": ["Remix Demo App Server", "Remix Demo App Client"],
      "presentation": {
        "hidden": false,
        "group": "Compounds",
        "order": 1
      },
      "stopAll": true
    },
  ],
}
