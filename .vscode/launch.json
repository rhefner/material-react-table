{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Remix Demo App Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/remix-demo",
      "command": "pnpm run dev",
    },
    {
      "name": "Remix Demo App Client",
      "type": "msedge",
      "request": "launch",
      "showAsyncStacks": true,
      "cleanUp": "wholeBrowser",
    },
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Port number",
    },
  ],
  "compounds": [
    {
      "name": "Debug Remix Demo (Client + Server)",
      "configurations": ["Remix Demo App Client", "Remix Demo App Server"],
    },
  ],
}
